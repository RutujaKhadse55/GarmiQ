{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertSchema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "headline": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "severity",
    "headline",
    "issued_at"
  ]
}